DOMAIN="tpot.yourdomain.com,tpot.otherdomain.com"
AUTH_KEY="your-secret-key-at-least-32-characters-long"
# PORT=3000

# OIDC Authentication (use instead of AUTH_KEY, not both)
# OIDC_DISCOVERY_URL="https://login.microsoftonline.com/{tenant-id}/v2.0"
# OIDC_ISSUER="https://sts.windows.net/{tenant-id}/"  # optional: override iss claim check
# OIDC_CLIENT_ID="your-client-id"
# OIDC_AUDIENCE="api://your-client-id"
# OIDC_SCOPES="openid api://your-client-id/access"
# OIDC_REQUIRED_CLAIMS="tid=your-tenant-id"
