{
  "name": "tpot",
  "version": "0.3.0",
  "description": "TPoT (Transport Packets over Tunnels): A simple (optionally authenticated) remote development/test/demo proxy over HTTP, powered by WebSockets. No additional ports required. Designed to be used with a reverse proxy for TLS.",
  "main": "dist/index.js",
  "bin": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test dist/test/**/*.test.js"
  },
  "author": "Zyno Consulting <oss@zyno.io>",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zyno-io/tpot.git",
    "directory": "packages/client"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ]
}
